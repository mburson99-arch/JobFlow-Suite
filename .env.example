# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# GOOGLE_CLIENT_ID: OAuth 2.0 Web client ID for Gmail integration.
# Create a Web application OAuth client in Google Cloud Console
# Add http://localhost:3000 as an authorized JavaScript origin
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# APP_URL: The URL where this application is running.
# For local development, use http://localhost:3000
APP_URL="http://localhost:3000"
